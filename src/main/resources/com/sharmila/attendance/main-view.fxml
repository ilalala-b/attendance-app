<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sharmila.attendance.MainController">
    <left>
        <VBox fx:id="sidebar" prefWidth="240" spacing="12" styleClass="sidebar">
            <padding>
                <Insets top="18" right="16" bottom="18" left="16" />
            </padding>
            <Label text="ATTENDANCE" styleClass="brand-title" />
            <Label text="Classes / Courses" styleClass="sidebar-title" />
            <ListView fx:id="courseList" VBox.vgrow="ALWAYS" styleClass="course-list" />
            <HBox spacing="8">
                <Button text="+ Add Class" onAction="#addCourse" styleClass="primary-button" HBox.hgrow="ALWAYS" />
                <Button text="Edit" onAction="#editCourse" fx:id="editCourseButton" styleClass="secondary-button" HBox.hgrow="ALWAYS" />
            </HBox>
            <Button text="Delete Class" onAction="#deleteCourse" fx:id="deleteCourseButton" maxWidth="Infinity" styleClass="danger-outline-button" />
        </VBox>
    </left>

    <center>
        <VBox spacing="12" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="18" left="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="courseTitle" text="Select a class" styleClass="course-title" />
                    <Label fx:id="teacherLabel" text="No class selected" styleClass="teacher-label" />
                </VBox>
                <Button text="Refresh" onAction="#refresh" styleClass="secondary-button" />
            </HBox>

            <Separator />

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar-card">
                <Label text="Session date:" styleClass="toolbar-label" />
                <DatePicker fx:id="sessionDatePicker" />
                <Label text="Period:" styleClass="toolbar-label" />
                <ChoiceBox fx:id="periodChoice" prefWidth="80" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Mark Period Present" onAction="#markAllPresent" styleClass="primary-button" />
            </HBox>

            <Label text="Attendance overview — 8 weeks × 4 periods. Click a cell to cycle Present / Absent / Clear." styleClass="hint-label" />

            <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS" styleClass="attendance-table" />

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button text="+ Add Student" onAction="#addStudent" styleClass="primary-button" />
                <Button text="Edit Student" onAction="#editStudent" fx:id="editStudentButton" styleClass="secondary-button" />
                <Button text="Delete Student" onAction="#deleteStudent" fx:id="deleteStudentButton" styleClass="danger-outline-button" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="statusLabel" text="Ready" styleClass="status-label" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
